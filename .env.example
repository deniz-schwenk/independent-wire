# Independent Wire — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the .env file.

# === Search Provider ===
# Default search provider (perplexity, brave, grok, ollama, duckduckgo)
# IW_SEARCH_PROVIDER=perplexity

# === API Keys ===

# OpenRouter (primary — for LLM calls AND Perplexity search)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# DeepSeek direct API (REQUIRED — primary channel for the three
# v4-flash-0731 stages: curator_topic_discovery, researcher_assemble,
# resolve_actor_aliases). Without it those stages cannot construct.
# Get your key at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# Ollama (optional — for Ollama search, web fetch, and cloud models)
# Get your key at https://ollama.com/settings/keys
# OLLAMA_API_KEY=your-ollama-key-here

# Brave Search (optional — for brave search provider)
# BRAVE_API_KEY=your-brave-key-here

# xAI / Grok (optional — for grok web search and X/Twitter search)
# XAI_API_KEY=your-xai-key-here
